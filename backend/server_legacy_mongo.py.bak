# ---------------- Auth endpoints (public + admin) ----------------
class LoginReq(BaseModel):
    email: str
    password: str


class CustomerUserCreate(BaseModel):
    email: str
    password: str
    customer_name: str
    name: str = ""


@api_router.post("/auth/login")
async def login(payload: LoginReq):
    email = payload.email.strip().lower()
    user = await db.users.find_one({"email": email})
    if not user or not verify_password(payload.password, user.get("password_hash", "")):
        raise HTTPException(status_code=401, detail="Invalid email or password")
    token = create_token(user)
    user["_id"] = str(user["_id"])
    user.pop("password_hash", None)
    return {"token": token, "user": user}


@api_router.get("/auth/me")
async def auth_me(user: dict = Depends(get_current_user)):
    return user


@admin_router.get("/auth/customers")
async def list_customer_users():
    docs = await db.users.find({"role": "customer"}).sort("created_at", -1).to_list(1000)
    for d in docs:
        d["_id"] = str(d["_id"])
        d.pop("password_hash", None)
    return docs


@admin_router.post("/auth/customers")
async def create_customer_user(payload: CustomerUserCreate):
    email = payload.email.strip().lower()
    if "@" not in email or "." not in email:
        raise HTTPException(status_code=400, detail="Invalid email address")
    if len(payload.password) < 6:
        raise HTTPException(status_code=400, detail="Password must be at least 6 characters")
    if await db.users.find_one({"email": email}):
        raise HTTPException(status_code=400, detail="Email already exists")
    doc = {
        "email": email,
        "password_hash": hash_password(payload.password),
        "name": payload.name or payload.customer_name,
        "customer_name": payload.customer_name,
        "role": "customer",
        "created_at": now_iso(),
    }
    res = await db.users.insert_one(doc)
    doc["_id"] = str(res.inserted_id)
    doc.pop("password_hash", None)
    return doc


@admin_router.delete("/auth/customers/{uid}")
async def delete_customer_user(uid: str):
    await db.users.delete_one({"_id": ObjectId(uid), "role": "customer"})
    return {"ok": True}


# ---------------- Inventory (Products) ----------------
class ProductCreate(BaseModel):
    name: str
    sku: str = ""
    stock: float = 0.0
    unit_cost: float = 0.0
    unit_price: float = 0.0
    low_stock_threshold: float = 5.0
    pc: str = ""
    superseded: str = ""
    superseded_from: str = ""
    model: str = ""
    availability: str = ""


@admin_router.post("/products/upload")
async def upload_products(file: UploadFile = File(...)):
    content = await file.read()
    fname = (file.filename or "").lower()
    rows = []
    if fname.endswith(".csv"):
        reader = csv.DictReader(io.StringIO(content.decode("utf-8", errors="ignore")))
        for r in reader:
            rows.append({(k or "").strip().lower(): v for k, v in r.items()})
    else:
        wb = load_workbook(io.BytesIO(content), read_only=True, data_only=True)
        ws = wb.active
        data = list(ws.iter_rows(values_only=True))
        headers = [str(h).strip().lower() if h else "" for h in data[0]]
        for r in data[1:]:
            if not any(r):
                continue
            rows.append({headers[i]: r[i] for i in range(len(headers)) if headers[i]})

    def g(row, *keys):
        for k in keys:
            if k in row and row[k] not in (None, ""):
                return row[k]
        return ""

    def fnum(v):
        try:
            return float(str(v).replace(",", "").strip() or 0)
        except Exception:
            return 0.0

    count = 0
    for r in rows:
        sku = str(g(r, "part number", "part no", "part no.", "sku", "code") or "").strip()
        name = str(g(r, "description", "name", "item") or sku).strip()
        if not sku and not name:
            continue
        doc = {
            "name": name,
            "sku": sku,
            "stock": fnum(g(r, "req qty", "req. qty", "qty", "quantity", "stock")),
            "unit_cost": fnum(g(r, "req. price", "req price", "cost", "unit_cost")),
            "unit_price": fnum(g(r, "net price", "price", "unit_price")),
            "pc": str(g(r, "pc") or ""),
            "superseded": str(g(r, "superseded") or ""),
            "superseded_from": str(g(r, "superseded from") or ""),
            "model": str(g(r, "model") or ""),
            "availability": str(g(r, "availability") or ""),
        }
        query = {"sku": sku} if sku else {"name": name}
        existing = await db.products.find_one(query)
        if existing:
            await db.products.update_one({"_id": existing["_id"]}, {"$set": doc})
        else:
            doc["low_stock_threshold"] = 5.0
            doc["created_at"] = now_iso()
            await db.products.insert_one(doc)
        count += 1
    if count == 0:
        raise HTTPException(status_code=400, detail="No valid rows. Expected columns like: Part Number, Description, Req Qty, Req. price, Net Price")
    return {"imported": count}


@admin_router.get("/products")
async def list_products():
    docs = await db.products.find().sort("name", 1).to_list(2000)
    return [clean(d) for d in docs]


@admin_router.post("/products")
async def create_product(payload: ProductCreate):
    data = payload.model_dump()
    data["created_at"] = now_iso()
    res = await db.products.insert_one(data)
    return clean(await db.products.find_one({"_id": res.inserted_id}))


@admin_router.put("/products/{pid}")
async def update_product(pid: str, payload: ProductCreate):
    await db.products.update_one({"_id": ObjectId(pid)}, {"$set": payload.model_dump()})
    return clean(await db.products.find_one({"_id": ObjectId(pid)}))


@admin_router.get("/products/low-stock")
async def low_stock():
    docs = await db.products.find().to_list(2000)
    return [clean(d) for d in docs if (d.get("stock", 0) <= d.get("low_stock_threshold", 0))]


@admin_router.delete("/products/{pid}")
async def delete_product(pid: str):
    await db.products.delete_one({"_id": ObjectId(pid)})
    return {"ok": True}


async def _adjust_stock(name, sku, qty):
    """Increment stock for a product identified by sku or name; create if missing."""
    query = {"sku": sku} if sku else {"name": name}
    prod = await db.products.find_one(query)
    if prod:
        await db.products.update_one({"_id": prod["_id"]}, {"$inc": {"stock": qty}})
    else:
        await db.products.insert_one({
            "name": name or sku, "sku": sku, "stock": max(qty, 0),
            "unit_cost": 0.0, "unit_price": 0.0, "low_stock_threshold": 5.0,
            "created_at": now_iso(),
        })


# ---------------- Purchases ----------------
class PurchaseItem(BaseModel):
    name: str = ""
    sku: str = ""
    qty: float = 0.0
    unit_cost: float = 0.0


class PurchaseCreate(BaseModel):
    supplier: str = ""
    ref: str = ""
    date: Optional[str] = None
    items: List[PurchaseItem] = []
    notes: str = ""


@admin_router.get("/purchases")
async def list_purchases(supplier: Optional[str] = None):
    q = {"supplier": supplier} if supplier else {}
    docs = await db.purchases.find(q).sort("date", -1).to_list(2000)
    return [clean(d) for d in docs]


@admin_router.post("/purchases")
async def create_purchase(payload: PurchaseCreate):
    data = payload.model_dump()
    if not data.get("date"):
        data["date"] = now_iso()
    data["total"] = sum(i["qty"] * i["unit_cost"] for i in data["items"])
    data["created_at"] = now_iso()
    res = await db.purchases.insert_one(data)
    for it in data["items"]:
        await _adjust_stock(it.get("name"), it.get("sku"), it.get("qty", 0))
        if it.get("unit_cost"):
            q = {"sku": it["sku"]} if it.get("sku") else {"name": it.get("name")}
            await db.products.update_one(q, {"$set": {"unit_cost": it["unit_cost"]}})
    return clean(await db.purchases.find_one({"_id": res.inserted_id}))


@admin_router.delete("/purchases/{pid}")
async def delete_purchase(pid: str):
    pur = await db.purchases.find_one({"_id": ObjectId(pid)})
    if pur:
        for it in pur.get("items", []):
            await _adjust_stock(it.get("name"), it.get("sku"), -it.get("qty", 0))
        await db.purchases.delete_one({"_id": ObjectId(pid)})
    return {"ok": True}


@admin_router.post("/purchases/upload")
async def upload_purchases(file: UploadFile = File(...), supplier: str = Form("")):
    content = await file.read()
    rows = []
    fname = (file.filename or "").lower()
    if fname.endswith(".csv"):
        text = content.decode("utf-8", errors="ignore")
        reader = csv.DictReader(io.StringIO(text))
        for r in reader:
            rows.append({(k or "").strip().lower(): v for k, v in r.items()})
    else:
        wb = load_workbook(io.BytesIO(content), read_only=True, data_only=True)
        ws = wb.active
        data = list(ws.iter_rows(values_only=True))
        headers = [str(h).strip().lower() if h else "" for h in data[0]]
        for r in data[1:]:
            if not any(r):
                continue
            rows.append({headers[i]: r[i] for i in range(len(headers)) if headers[i]})

    def g(row, *keys):
        for k in keys:
            if k in row and row[k] not in (None, ""):
                return row[k]
        return ""

    def fnum(v):
        try:
            return float(str(v).replace(",", "").strip() or 0)
        except Exception:
            return 0.0

    items = []
    for r in rows:
        name = str(g(r, "description", "name", "product", "item") or "").strip()
        sku = str(g(r, "part number", "part no", "part no.", "sku", "code") or "").strip()
        if not name and not sku:
            continue
        items.append({
            "name": name or sku,
            "sku": sku,
            "qty": fnum(g(r, "confirmed qty", "confirmed quantity", "qty", "quantity")),
            "unit_cost": fnum(g(r, "price", "unit_cost", "cost")),
        })
    if not items:
        raise HTTPException(status_code=400, detail="No valid rows found. Expected columns: Part Number, Description, Confirmed Qty, Price, Total")
    payload = PurchaseCreate(supplier=supplier, ref=f"UPLOAD-{file.filename}", items=[PurchaseItem(**i) for i in items])
    result = await create_purchase(payload)
    return {"created": True, "items": len(items), "purchase": result}


class ReorderItem(BaseModel):
    product_id: str
    qty: float = 0.0


class ReorderReq(BaseModel):
    supplier: str = ""
    items: List[ReorderItem] = []


@admin_router.post("/purchases/reorder")
async def reorder(payload: ReorderReq):
    items = []
    for r in payload.items:
        prod = await db.products.find_one({"_id": ObjectId(r.product_id)})
        if not prod or r.qty <= 0:
            continue
        items.append(PurchaseItem(name=prod["name"], sku=prod.get("sku", ""), qty=r.qty, unit_cost=prod.get("unit_cost", 0)))
    if not items:
        raise HTTPException(status_code=400, detail="No items to reorder")
    return await create_purchase(PurchaseCreate(supplier=payload.supplier, ref="REORDER", items=items))


@admin_router.post("/purchases/scan")
async def scan_purchase(file: UploadFile = File(...)):
    if not AI_AVAILABLE:
        raise HTTPException(status_code=503, detail="AI purchase-invoice scanning is unavailable in this environment (emergentintegrations not installed).")
    content = await file.read()
    b64 = base64.b64encode(content).decode("utf-8")
    chat = LlmChat(
        api_key=EMERGENT_LLM_KEY, session_id=f"pscan-{uuid.uuid4()}",
        system_message=(
            "You extract purchase invoice data. Respond with ONLY valid JSON (no fences) with keys: "
            "supplier (string), ref (string), items (array of {name, sku, qty, unit_cost}). Use 0/empty for unknowns."
        ),
    ).with_model("openai", MODEL)
    resp = await chat.send_message(UserMessage(text="Extract purchase invoice as JSON.", file_contents=[ImageContent(image_base64=b64)]))
    text = resp.strip()
    if text.startswith("```"):
        text = text.split("```")[1].replace("json", "", 1).strip()
    try:
        return json.loads(text)
    except Exception:
        s, e = text.find("{"), text.rfind("}")
        return json.loads(text[s:e + 1]) if s >= 0 else {"supplier": "", "items": []}


# ---------------- Invoices ----------------
class InvoiceItem(BaseModel):
    product_id: str = ""
    name: str = ""
    sku: str = ""
    description: str = ""
    qty: float = 0.0
    unit_price: float = 0.0
    req_price: float = 0.0
    pc: str = ""
    superseded: str = ""
    superseded_from: str = ""
    model: str = ""
    availability: str = ""


class InvoiceCreate(BaseModel):
    invoice_number: str
    customer: str = ""
    date: Optional[str] = None
    items: List[InvoiceItem] = []
    tax_percent: float = 0.0
    status: str = "unpaid"
    notes: str = ""
    ship_type: str = "EX-STOCK"
    currency: str = "AED"


def _invoice_totals(data):
    subtotal = sum(i["qty"] * i["unit_price"] for i in data["items"])
    tax = subtotal * (data.get("tax_percent", 0) / 100.0)
    data["subtotal"] = round(subtotal, 2)
    data["tax"] = round(tax, 2)
    data["total"] = round(subtotal + tax, 2)
    return data


@admin_router.get("/invoices")
async def list_invoices():
    docs = await db.invoices.find().sort("date", -1).to_list(2000)
    return [clean(d) for d in docs]


@admin_router.post("/invoices")
async def create_invoice(payload: InvoiceCreate):
    data = payload.model_dump()
    if await db.invoices.find_one({"invoice_number": data["invoice_number"]}):
        raise HTTPException(status_code=400, detail="Invoice number already exists")
    # validate stock availability for tracked products
    for it in data["items"]:
        if it.get("product_id"):
            prod = await db.products.find_one({"_id": ObjectId(it["product_id"])})
            if prod and (prod.get("stock", 0) < it.get("qty", 0)):
                raise HTTPException(status_code=400, detail=f"Not enough stock for {prod.get('name')}: {prod.get('stock',0)} available")
    if not data.get("date"):
        data["date"] = now_iso()
    data = _invoice_totals(data)
    data["created_at"] = now_iso()
    res = await db.invoices.insert_one(data)
    for it in data["items"]:
        if it.get("product_id"):
            await db.products.update_one({"_id": ObjectId(it["product_id"])}, {"$inc": {"stock": -it.get("qty", 0)}})
    return clean(await db.invoices.find_one({"_id": res.inserted_id}))


@admin_router.delete("/invoices/{iid}")
async def delete_invoice(iid: str):
    inv = await db.invoices.find_one({"_id": ObjectId(iid)})
    if inv:
        for it in inv.get("items", []):
            if it.get("product_id"):
                await db.products.update_one({"_id": ObjectId(it["product_id"])}, {"$inc": {"stock": it.get("qty", 0)}})
        await db.invoices.delete_one({"_id": ObjectId(iid)})
    return {"ok": True}


class InvoiceStatusReq(BaseModel):
    status: str


@admin_router.patch("/invoices/{iid}/status")
async def set_invoice_status(iid: str, payload: InvoiceStatusReq):
    await db.invoices.update_one({"_id": ObjectId(iid)}, {"$set": {"status": payload.status}})
    return clean(await db.invoices.find_one({"_id": ObjectId(iid)}))


@admin_router.put("/invoices/{iid}")
async def update_invoice(iid: str, payload: InvoiceCreate):
    existing = await db.invoices.find_one({"_id": ObjectId(iid)})
    if not existing:
        raise HTTPException(status_code=404, detail="Invoice not found")
    dup = await db.invoices.find_one({"invoice_number": payload.invoice_number, "_id": {"$ne": ObjectId(iid)}})
    if dup:
        raise HTTPException(status_code=400, detail="Invoice number already exists")

    data = payload.model_dump()
    data = _invoice_totals(data)

    # net stock change per product: old_qty - new_qty (positive => stock returns)
    def qty_map(items):
        m = {}
        for it in items:
            if it.get("product_id"):
                m[it["product_id"]] = m.get(it["product_id"], 0) + it.get("qty", 0)
        return m

    old_m = qty_map(existing.get("items", []))
    new_m = qty_map(data["items"])
    for pid in set(list(old_m) + list(new_m)):
        net = old_m.get(pid, 0) - new_m.get(pid, 0)
        if net < 0:  # stock must decrease further
            prod = await db.products.find_one({"_id": ObjectId(pid)})
            if prod and prod.get("stock", 0) < (-net):
                raise HTTPException(status_code=400, detail=f"Not enough stock for {prod.get('name')}: {prod.get('stock',0)} available")

    data["date"] = existing.get("date")
    data["created_at"] = existing.get("created_at")
    await db.invoices.update_one({"_id": ObjectId(iid)}, {"$set": data})
    for pid in set(list(old_m) + list(new_m)):
        net = old_m.get(pid, 0) - new_m.get(pid, 0)
        if net != 0:
            await db.products.update_one({"_id": ObjectId(pid)}, {"$inc": {"stock": net}})
    return clean(await db.invoices.find_one({"_id": ObjectId(iid)}))


@admin_router.get("/invoices/{iid}/excel")
async def invoice_excel(iid: str):
    inv = await db.invoices.find_one({"_id": ObjectId(iid)})
    if not inv:
        raise HTTPException(status_code=404, detail="Invoice not found")
    from openpyxl import Workbook
    from openpyxl.styles import Font, Alignment, PatternFill
    wb = Workbook()
    ws = wb.active
    ws.title = "Invoice"
    ws["A1"] = "TAX INVOICE / فاتورة ضريبية"
    ws["A1"].font = Font(bold=True, size=14)
    ws["A2"] = f"Invoice No / رقم الفاتورة: {inv.get('invoice_number','')}"
    ws["A3"] = f"Customer / العميل: {inv.get('customer','')}"
    ws["A4"] = f"Date / التاريخ: {(inv.get('date') or '')[:10]}"
    headers = [
        "S.NO رقم", "Part No. رقم القطع", "Description التفاصيل", "QTY/Pcs. العدد",
        "AED/Pc. سعر الوحدة", "Taxable Amount AED المبلغ", "VAT Rate % معدل الضريبة",
        "VAT Amount AED الضريبة", "TOTAL (incl VAT) AED المبلغ الأجمالي",
    ]
    hrow = 6
    fill = PatternFill(start_color="2C302B", end_color="2C302B", fill_type="solid")
    for c, h in enumerate(headers, start=1):
        cell = ws.cell(row=hrow, column=c, value=h)
        cell.font = Font(bold=True, color="FFFFFF", size=9)
        cell.fill = fill
        cell.alignment = Alignment(wrap_text=True, horizontal="center", vertical="center")
    rate = inv.get("tax_percent", 0) or 0
    r = hrow + 1
    for i, it in enumerate(inv.get("items", []), start=1):
        taxable = (it.get("qty", 0) or 0) * (it.get("unit_price", 0) or 0)
        vat = taxable * rate / 100.0
        ws.cell(row=r, column=1, value=i)
        ws.cell(row=r, column=2, value=it.get("sku", ""))
        ws.cell(row=r, column=3, value=it.get("name", ""))
        ws.cell(row=r, column=4, value=it.get("qty", 0))
        ws.cell(row=r, column=5, value=round(it.get("unit_price", 0), 2))
        ws.cell(row=r, column=6, value=round(taxable, 2))
        ws.cell(row=r, column=7, value=rate)
        ws.cell(row=r, column=8, value=round(vat, 2))
        ws.cell(row=r, column=9, value=round(taxable + vat, 2))
        r += 1
    ws.cell(row=r + 1, column=8, value="Subtotal").font = Font(bold=True)
    ws.cell(row=r + 1, column=9, value=round(inv.get("subtotal", 0), 2))
    ws.cell(row=r + 2, column=8, value="VAT").font = Font(bold=True)
    ws.cell(row=r + 2, column=9, value=round(inv.get("tax", 0), 2))
    ws.cell(row=r + 3, column=8, value="TOTAL").font = Font(bold=True)
    ws.cell(row=r + 3, column=9, value=round(inv.get("total", 0), 2))
    widths = [8, 16, 32, 10, 14, 18, 14, 16, 20]
    for c, w in enumerate(widths, start=1):
        ws.column_dimensions[ws.cell(row=hrow, column=c).column_letter].width = w
    buf = io.BytesIO()
    wb.save(buf)
    buf.seek(0)
    return Response(
        content=buf.read(),
        media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        headers={"Content-Disposition": f"attachment; filename=invoice-{inv.get('invoice_number','')}.xlsx"},
    )


