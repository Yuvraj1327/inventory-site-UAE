    return {"ok": True}


# ---------------- Statement of Account ----------------
@admin_router.get("/soa/{kind}/{name}")
async def statement_of_account(kind: str, name: str):
    field = "customer" if kind == "customer" else "supplier"
    rows = []

    orders = await db.orders.find({field: name}).to_list(1000)
    for o in orders:
        if kind == "customer":
            billed, paid = o.get("sale_amount", 0.0), o.get("received_amount", 0.0)
        else:
            billed, paid = o.get("supplier_cost", 0.0), o.get("paid_to_supplier", 0.0)
        rows.append({"ref": o.get("order_number", ""), "order_number": o.get("order_number", ""),
                     "type": "Order", "date": o.get("order_date", ""), "billed": billed, "paid": paid,
                     "balance": 0, "status": o.get("status", "")})

    if kind == "customer":
        invoices = await db.invoices.find({"customer": name}).to_list(1000)
        for inv in invoices:
            total = inv.get("total", 0) or 0
            rows.append({"ref": inv.get("invoice_number", ""), "order_number": inv.get("invoice_number", ""),
                         "type": "Invoice", "date": inv.get("date", ""), "billed": total,
                         "paid": total if inv.get("status") == "paid" else 0, "balance": 0,
                         "status": inv.get("status", "")})

    pay_kind = "payment_in" if kind == "customer" else "payment_out"
    payments = await db.transactions.find({"party": name, "kind": pay_kind}).to_list(1000)
    for p in payments:
        rows.append({"ref": p.get("receipt_no") or "Payment", "order_number": p.get("receipt_no") or "Payment",
                     "type": "Payment", "date": p.get("date", ""), "billed": 0, "paid": p.get("amount", 0),
                     "balance": 0, "status": "paid"})

    rows.sort(key=lambda r: r.get("date") or "")
    running = 0.0
    total_billed = 0.0
    total_paid = 0.0
    for r in rows:
        total_billed += r["billed"]
        total_paid += r["paid"]
        running += (r["billed"] - r["paid"])
        r["balance"] = round(running, 2)
    return {
        "name": name, "kind": kind, "rows": rows,
        "total_billed": round(total_billed, 2), "total_paid": round(total_paid, 2),
        "balance": round(total_billed - total_paid, 2),
    }


# ---------------- Dashboard ----------------
@admin_router.get("/dashboard")
async def dashboard():
    txns = await db.transactions.find().to_list(5000)
    orders = await db.orders.find().to_list(5000)

    total_income = sum(t["amount"] for t in txns if t["type"] == "income")
    total_expense = sum(t["amount"] for t in txns if t["type"] == "expense")

    # category breakdown for expenses
    cats = {}
    for t in txns:
        if t["type"] == "expense":
            cats[t.get("category", "Other")] = cats.get(t.get("category", "Other"), 0) + t["amount"]
    category_breakdown = [{"name": k, "value": round(v, 2)} for k, v in sorted(cats.items(), key=lambda x: -x[1])]

    # monthly trend
    monthly = {}
    for t in txns:
        month = (t.get("date") or "")[:7]
        if not month:
            continue
        monthly.setdefault(month, {"month": month, "income": 0, "expense": 0})
        monthly[month][t["type"]] += t["amount"]
    monthly_trend = sorted(monthly.values(), key=lambda x: x["month"])[-6:]

    order_revenue = sum(o.get("sale_amount", 0) for o in orders)
    order_cost = sum(o.get("supplier_cost", 0) for o in orders)
    order_profit = order_revenue - order_cost
    receivables = sum(o.get("sale_amount", 0) - o.get("received_amount", 0) for o in orders)
    payables = sum(o.get("supplier_cost", 0) - o.get("paid_to_supplier", 0) for o in orders)

    return {
        "total_income": round(total_income, 2),
        "total_expense": round(total_expense, 2),
        "net_profit": round(total_income - total_expense, 2),
        "transaction_count": len(txns),
        "order_count": len(orders),
        "order_revenue": round(order_revenue, 2),
        "order_profit": round(order_profit, 2),
        "receivables": round(receivables, 2),
        "payables": round(payables, 2),
        "category_breakdown": category_breakdown,
        "monthly_trend": monthly_trend,
    }


# ---------------- Receipt Scanner ----------------
@admin_router.post("/scan-receipt")
async def scan_receipt(file: UploadFile = File(...)):
    if not AI_AVAILABLE:
        raise HTTPException(status_code=503, detail="Receipt scanning is unavailable in this environment (emergentintegrations not installed).")
    content = await file.read()
    b64 = base64.b64encode(content).decode("utf-8")
    chat = LlmChat(
        api_key=EMERGENT_LLM_KEY,
        session_id=f"scan-{uuid.uuid4()}",
        system_message=(
            "You are an expert receipt and invoice OCR extraction engine. Extract structured data "
            "from the image and respond with ONLY a valid JSON object (no markdown, no code fences) "
            "with keys: vendor (string), date (string YYYY-MM-DD or empty), total (number), "
            "tax (number), currency (string), category (string best-guess expense category), "
            "line_items (array of {description, amount}). Use 0 for unknown numbers and empty string for unknown text."
        ),
    ).with_model("openai", MODEL)
    msg = UserMessage(
        text="Extract the receipt/invoice data as JSON.",
        file_contents=[ImageContent(image_base64=b64)],
    )
    resp = await chat.send_message(msg)
    text = resp.strip()
    if text.startswith("```"):
        text = text.split("```")[1] if "```" in text else text
        text = text.replace("json", "", 1).strip()
    try:
        data = json.loads(text)
    except Exception:
        start = text.find("{")
        end = text.rfind("}")
        data = json.loads(text[start:end + 1]) if start >= 0 else {"vendor": "", "total": 0}
    return data


# ---------------- AI Chat (streaming) ----------------
@admin_router.get("/chat/{session_id}")
async def chat_history(session_id: str):
    docs = await db.chat_messages.find({"session_id": session_id}).sort("created_at", 1).to_list(1000)
    return [clean(d) for d in docs]


@admin_router.post("/chat")
async def chat(payload: ChatRequest):
    if not AI_AVAILABLE:
        raise HTTPException(status_code=503, detail="AI assistant is unavailable in this environment (emergentintegrations not installed).")
    await db.chat_messages.insert_one({
        "session_id": payload.session_id,
        "role": "user",
        "content": payload.message,
        "created_at": now_iso(),
    })

    # Provide business context to the assistant
    dash = await dashboard()
    context = (
        f"Business snapshot -> Income: {dash['total_income']}, Expenses: {dash['total_expense']}, "
        f"Net profit: {dash['net_profit']}, Receivables: {dash['receivables']}, Payables: {dash['payables']}, "
        f"Orders: {dash['order_count']}."
    )

    chat_client = LlmChat(
        api_key=EMERGENT_LLM_KEY,
        session_id=payload.session_id,
        system_message=(
            "You are an expert AI accountant and financial advisor for a small business owner. "
            "Answer questions about accounting, bookkeeping, taxes, cash flow and their business "
            "finances clearly and concisely. Use the provided business snapshot when relevant. "
            + context
        ),
    ).with_model("openai", MODEL)

    async def event_generator():
        full = ""
        async for event in chat_client.stream_message(UserMessage(text=payload.message)):
            if isinstance(event, TextDelta):
                full += event.content
                yield f"data: {json.dumps({'delta': event.content})}\n\n"
            elif isinstance(event, StreamDone):
                break
        await db.chat_messages.insert_one({
            "session_id": payload.session_id,
            "role": "assistant",
            "content": full,
            "created_at": now_iso(),
        })
        yield f"data: {json.dumps({'done': True})}\n\n"

    return StreamingResponse(
        event_generator(),
        media_type="text/event-stream",
        headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
    )


# ---------------- Payment Reminders ----------------
@admin_router.get("/reminders")
async def reminders():
    orders = await db.orders.find().to_list(5000)
    agg = {}
    for o in orders:
        cust = (o.get("customer") or "").strip()
        if not cust:
            continue
        bal = (o.get("sale_amount", 0) or 0) - (o.get("received_amount", 0) or 0)
        e = agg.setdefault(cust, {"customer": cust, "outstanding": 0.0, "orders": 0, "last_date": ""})
        e["outstanding"] += bal
        e["orders"] += 1
        d = o.get("order_date", "") or ""
        if d > e["last_date"]:
            e["last_date"] = d
    result = [v for v in agg.values() if v["outstanding"] > 0.009]
    result.sort(key=lambda x: -x["outstanding"])
    for r in result:
        r["outstanding"] = round(r["outstanding"], 2)
    return result


class DraftReq(BaseModel):
    customer: str
    outstanding: float
    tone: str = "friendly"


@admin_router.post("/reminders/draft")
async def draft_reminder(payload: DraftReq):
    if not AI_AVAILABLE:
        raise HTTPException(status_code=503, detail="AI reminder drafting is unavailable in this environment (emergentintegrations not installed).")
    chat = LlmChat(
        api_key=EMERGENT_LLM_KEY,
        session_id=f"draft-{uuid.uuid4()}",
        system_message=(
            "You write short, polite, professional payment reminder emails for a small business. "
            "Keep it under 130 words, warm but clear. Include a 'Subject:' line at the top."
        ),
    ).with_model("openai", MODEL)
    resp = await chat.send_message(UserMessage(
        text=(
            f"Write a {payload.tone} payment reminder email to a customer named '{payload.customer}' "
            f"who has an outstanding balance of ${payload.outstanding:.2f}. "
            "Politely ask them to settle the balance and offer to help with any questions."
        )
    ))
    return {"message": resp.strip()}


