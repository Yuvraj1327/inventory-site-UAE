def clean(doc):
    if doc and "_id" in doc:
        doc["_id"] = str(doc["_id"])
    return doc


# ---------------- Transactions ----------------
@admin_router.get("/transactions")
async def list_transactions():
    docs = await db.transactions.find().sort("date", -1).to_list(1000)
    return [clean(d) for d in docs]


@admin_router.post("/transactions")
async def create_transaction(payload: TransactionCreate):
    data = payload.model_dump()
    if not data.get("date"):
        data["date"] = now_iso()
    kind = data.get("kind") or "cash_expense"
    if kind == "payment_in":
        data["type"] = "income"
        if not data.get("category") or data["category"] == "Uncategorized":
            data["category"] = "Payment from Customer"
        doc = await db.counters.find_one_and_update(
            {"_id": "receipt"}, {"$inc": {"seq": 1}}, upsert=True, return_document=ReturnDocument.AFTER)
        data["receipt_no"] = f"RCPT{doc['seq']:05d}"
    elif kind == "payment_out":
        data["type"] = "expense"
        if not data.get("category") or data["category"] == "Uncategorized":
            data["category"] = "Payment to Supplier"
    elif kind == "cash_expense":
        data["type"] = "expense"
    else:
        data["type"] = data.get("type") or "expense"
    data["created_at"] = now_iso()
    res = await db.transactions.insert_one(data)
    doc = await db.transactions.find_one({"_id": res.inserted_id})
    return clean(doc)


@admin_router.put("/transactions/{tid}")
async def update_transaction(tid: str, payload: TransactionCreate):
    data = {k: v for k, v in payload.model_dump().items() if v is not None}
    await db.transactions.update_one({"_id": ObjectId(tid)}, {"$set": data})
    doc = await db.transactions.find_one({"_id": ObjectId(tid)})
    return clean(doc)


@admin_router.delete("/transactions/{tid}")
async def delete_transaction(tid: str):
    await db.transactions.delete_one({"_id": ObjectId(tid)})
    return {"ok": True}


@admin_router.post("/transactions/categorize")
async def categorize_transaction(payload: dict):
    if not AI_AVAILABLE:
        raise HTTPException(status_code=503, detail="AI categorization is unavailable in this environment (emergentintegrations not installed).")
    desc = payload.get("description", "")
    ttype = payload.get("type", "expense")
    categories = [
        "Sales Revenue", "Service Income", "Office Supplies", "Rent", "Utilities",
        "Salaries & Wages", "Marketing", "Travel", "Meals & Entertainment",
        "Software & Subscriptions", "Inventory / COGS", "Professional Fees",
        "Taxes", "Bank Charges", "Insurance", "Other",
    ]
    chat = LlmChat(
        api_key=EMERGENT_LLM_KEY,
        session_id=f"cat-{uuid.uuid4()}",
        system_message=(
            "You are an accounting assistant. Given a transaction description, return ONLY "
            "the single best matching category from this list, nothing else: "
            + ", ".join(categories)
        ),
    ).with_model("openai", MODEL)
    resp = await chat.send_message(UserMessage(text=f"Type: {ttype}. Description: {desc}"))
    category = resp.strip().strip('"').strip(".")
    if category not in categories:
        for c in categories:
            if c.lower() in category.lower():
                category = c
                break
        else:
            category = "Other"
    return {"category": category}


