async def next_account_no():
    doc = await db.counters.find_one_and_update(
        {"_id": "customer_account"},
        {"$inc": {"seq": 1}},
        upsert=True,
        return_document=ReturnDocument.AFTER,
    )
    return f"AC{doc['seq']:05d}"


def make_lpo(name: str, phone: str) -> str:
    words = [w for w in re.split(r"\s+", (name or "").strip()) if w]
    if len(words) >= 2:
        abbr = "".join(w[0] for w in words[:4]).upper()
    else:
        abbr = (name or "").strip()[:3].upper()
    digits = re.sub(r"\D", "", phone or "")
    last2 = digits[-2:] if len(digits) >= 2 else digits
    return f"{abbr}{last2}"


@admin_router.post("/parties")
async def create_party(payload: PartyCreate):
    data = payload.model_dump()
    data["created_at"] = now_iso()
    if data.get("kind") == "customer":
        data["account_no"] = await next_account_no()
        data["lpo"] = make_lpo(data.get("name", ""), data.get("mobile") or data.get("phone") or "")
    res = await db.parties.insert_one(data)
    doc = await db.parties.find_one({"_id": res.inserted_id})
    return clean(doc)


