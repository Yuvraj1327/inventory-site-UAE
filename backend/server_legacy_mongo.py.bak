def derive_order_totals(data):
    sv, svat = data.get("selling_value") or 0, data.get("selling_vat") or 0
    if sv or svat:
        data["sale_amount"] = sv + svat
    pv, pvat = data.get("purchasing_value") or 0, data.get("vat_amount") or 0
    if pv or pvat:
        data["supplier_cost"] = pv + pvat
    return data


@admin_router.post("/orders")
async def create_order(payload: OrderCreate):
    data = payload.model_dump()
    if not data.get("order_date"):
        data["order_date"] = now_iso()
    data = derive_order_totals(data)
    data["created_at"] = now_iso()
    res = await db.orders.insert_one(data)
    doc = await db.orders.find_one({"_id": res.inserted_id})
    return clean(doc)


@admin_router.put("/orders/{oid}")
async def update_order(oid: str, payload: OrderCreate):
    data = derive_order_totals(payload.model_dump())
    await db.orders.update_one({"_id": ObjectId(oid)}, {"$set": data})
    doc = await db.orders.find_one({"_id": ObjectId(oid)})
    return clean(doc)


@admin_router.delete("/orders/{oid}")
async def delete_order(oid: str):
    await db.orders.delete_one({"_id": ObjectId(oid)})
    return {"ok": True}


